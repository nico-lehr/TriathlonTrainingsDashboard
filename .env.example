# Vorlage fuer die Datei .env (start.bat / start.sh legen .env beim ersten
# Start automatisch an). .env enthaelt Geheimnisse und wird NIE ins
# Repository geladen (.gitignore).

# Signiert die Login-Token. Ohne diesen Wert startet der Server nicht.
# Einen langen Zufallswert erzeugen:  python -c "import secrets; print(secrets.token_hex(32))"
# Wer ihn aendert, meldet alle Benutzer ab (alte Token und Kalender-Links werden ungueltig).
SECRET_KEY=

# Ollama fuer den KI-Coach (Standard: Ollama auf diesem PC)
# OLLAMA_URL=http://localhost:11434

# Wo der Server lauscht (Standard: alle Netzwerke, Port 5000). Nur ueber
# Tailscale erreichbar machen: DASHBOARD_HOST auf die Tailscale-IP (100.x.y.z) setzen.
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=5000
