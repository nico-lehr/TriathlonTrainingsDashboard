# Vorlage fuer die Datei .env (diese Datei kopieren, Kopie ".env" nennen).
# .env enthaelt Geheimnisse und wird NIE ins Repository geladen (.gitignore).

# Signiert die Login-Token. Ohne diesen Wert startet der Server nicht.
# Einen langen Zufallswert erzeugen:  python -c "import secrets; print(secrets.token_hex(32))"
# Wer ihn aendert, meldet alle Benutzer ab (alte Token werden ungueltig).
SECRET_KEY=
