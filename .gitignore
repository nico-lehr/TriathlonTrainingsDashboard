# Enthält echte, persönliche Trainingsdaten (Herzfrequenz, Zeiten, Distanzen,
# Kalorien) - bleibt bewusst lokal und wird nicht ins öffentliche Repo geladen.
workouts.json

# Generiert aus workouts.json (siehe build_dashboard.py) und enthält daher
# dieselben persönlichen Trainingsdaten eingebettet - ebenfalls lokal, nicht
# im Repo. index.html selbst ist reiner Code und bleibt im Repo.
data/workouts-data.js

# Export des alten Doppelklick-Dashboards (tools/export-browser-data.html) -
# enthaelt Profil, Ziele, Plan und Workouts, gehoert nie ins Repo.
dashboard-export.json

# Garmin-Sync (tools/garmin_sync.py): persoenliche Gesundheitsdaten
# (Schlaf, HRV, Ruhepuls, Gewicht) bzw. die heruntergeladenen Originaldateien.
# Bleibt alles lokal, nichts davon gehoert ins Repo.
data/wellness-data.js
data/garmin-raw-cache.json
fit-files/

# Zugangsdaten/Token - duerfen NIE ins Repo. Der eigentliche Token liegt
# ohnehin ausserhalb des Projekts (~/.garminconnect), diese Regeln sind die
# Absicherung gegen ein versehentlich hier abgelegtes Exemplar.
.garminconnect/
garmin_tokens.json
oauth1_token.json
oauth2_token.json

# Erzeugte Einzeldatei-Demo (4-5 MB, wird von build-demo.py generiert).
# Gehoert nicht ins Repo - die veroeffentlichte Fassung liegt im
# Landingpage-Projekt als dashboard.html.
dashboard-demo.html

